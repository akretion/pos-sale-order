<odoo>

    <t t-name="PrintReceiptToggleButton" owl="1">
        <div class="button" att-class="{ 'higlight': state.shouldHighlight }">
            <i
                class='fa'
                t-att-class="{ 'fa-print': !currentOrder.get('no_receipt') , 'fa-ban': currentOrder.get('no_receipt') }"
            />
            <t t-if="currentOrder.get('no_receipt')">No Receipt</t>
            <t t-else="">Print Receipt</t>
        </div>
    </t>

    <t
        t-name="PaymentScreen"
        t-inherit="point_of_sale.PaymentScreen"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[contains(@class, 'payment-controls')]" position="inside">
            <PrintReceiptToggleButton />
        </xpath>
    </t>

</odoo>
