<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_line_form" model="ir.ui.view">
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form" />
        <field name="arch" type="xml">
            <page name="information" position="inside">
                <group string="Point Of Sale">
                    <field name="pos_session_id" />
                    <field name="pos_config_id" />
                </group>
            </page>
        </field>
    </record>
    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="pos_session_id" optional="hide" />
                <field name="pos_config_id" optional="hide" />
            </field>
        </field>
    </record>
    <record id="view_account_move_line_filter" model="ir.ui.view">
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter" />
        <field name="arch" type="xml">
            <filter name="groupby_date" position="after">
                <filter
                    string="PoS"
                    name="pos"
                    domain="[]"
                    context="{'group_by': 'pos_config_id'}"
                />
                <filter
                    string="Pos Session"
                    name="pos_session"
                    domain="[]"
                    context="{'group_by': 'pos_session_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
